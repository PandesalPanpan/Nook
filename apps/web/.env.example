# Leave these unset for the complete local-only application.
# Copy to .env.local and supply public config from a dedicated Nook project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
# Development only: 127.0.0.1 with the demo-nook emulators.
VITE_FIREBASE_EMULATOR_HOST=
