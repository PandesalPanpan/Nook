{
  "name": "nook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/schemas"
  ],
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "test": "vitest run",
    "dev": "npm run dev --workspace @nook/web",
    "build": "npm run build --workspace @nook/web",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/web/src packages/schemas/src firebase/*.ts *.ts",
    "test:rules": "firebase emulators:exec --project demo-nook --only auth,firestore,storage \"vitest run --config vitest.emulator.config.ts\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "mdast-util-from-markdown": "^2.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.2",
    "firebase-tools": "^15.32.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
